[Unit]
Description=Haptic belt 2 / PCB2 (upper - elevated obstacles) - ws :8001
After=sound.target network-online.target
Wants=network-online.target

[Service]
# __USER__ / __REPO_DIR__ / __PYTHON__ are filled in by install.sh.
User=__USER__
WorkingDirectory=__REPO_DIR__
ExecStart=__PYTHON__ server.py .env.pcb2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
