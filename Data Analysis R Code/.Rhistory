geom_point() +
geom_smooth(method = "lm") +
labs(title = paste("Age vs Localization Accuracy -", device),
x = "Age (years)",
y = "Accuracy") +
theme_minimal()
print(p)
} else {
cat("Still insufficient Age data after join\n")
}
} else {
